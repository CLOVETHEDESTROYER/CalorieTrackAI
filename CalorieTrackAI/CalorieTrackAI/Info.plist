<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>My Fatness Tracker</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>My Fatness</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <true/>
    </dict>
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>AccentColor</string>
        <key>UIImageName</key>
        <string>AppIcon</string>
    </dict>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- Permissions for app features -->
    <key>NSCameraUsageDescription</key>
    <string>My Fatness Tracker uses the camera to scan food barcodes, analyze meal photos for nutrition logging, and check push-up form for movement challenge points.</string>
    <key>NSHealthShareUsageDescription</key>
    <string>My Fatness Tracker reads steps, workouts, active energy, and exercise minutes from Health to show activity progress.</string>
    <key>NSHealthUpdateUsageDescription</key>
    <string>My Fatness Tracker may save activity-related updates to Health only when you allow it, so your workout and activity history stays consistent.</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>My Fatness Tracker uses saved gym locations to detect optional gym check-ins for your activity history.</string>
    <key>NSLocationAlwaysUsageDescription</key>
    <string>My Fatness Tracker uses saved gym locations to detect optional gym check-ins for your activity history.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>My Fatness Tracker uses your location to search nearby gyms and support gym check-ins.</string>
    <key>NSLocationTemporaryUsageDescriptionDictionary</key>
    <dict>
        <key>GymArrivalPrecision</key>
        <string>My Fatness Tracker uses precise location briefly to verify you reached the saved gym entrance before awarding an automatic check-in.</string>
    </dict>
    <key>NSMicrophoneUsageDescription</key>
    <string>My Fatness Tracker needs microphone access for voice input when logging foods.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>My Fatness Tracker uses speech recognition to convert your voice input into food entries.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>My Fatness Tracker needs photo library access to analyze food photos for nutrition information.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>My Fatness Tracker needs permission to save food photos to your library.</string>

    <!-- App Transport Security -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
    </dict>

    <!-- Supabase Auth deep link for email confirmation and password recovery -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.hyperlabsAI.CalorieTrackAI.auth</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>myfatnesstracker</string>
            </array>
        </dict>
    </array>

    <!-- API Configuration - Values loaded from Config.xcconfig -->
    <!-- To set up: Copy Config.xcconfig.template to Config.xcconfig and add your keys -->
    <key>SUPABASE_URL</key>
    <string>$(SUPABASE_URL)</string>
    <key>SUPABASE_PUBLISHABLE_KEY</key>
    <string>$(SUPABASE_PUBLISHABLE_KEY)</string>
    <key>SUPABASE_ANON_KEY</key>
    <string>$(SUPABASE_ANON_KEY)</string>
    <key>MFT_UNLOCK_FEATURES_FOR_TESTING</key>
    <true/>
</dict>
</plist>
