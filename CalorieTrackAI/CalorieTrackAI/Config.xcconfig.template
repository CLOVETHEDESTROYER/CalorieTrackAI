// My Fatness Tracker Configuration Template
//
// SETUP INSTRUCTIONS:
// 1. Copy this file and rename it to "Config.xcconfig"
// 2. Replace the placeholder values with your actual API keys
// 3. The actual Config.xcconfig file is in .gitignore and won't be committed
//
// To get your Supabase keys:
// - Supabase: https://supabase.com/dashboard (Project Settings > API)
// Keep OPENAI_API_KEY in Supabase Edge Function secrets, not in this file.

// Supabase Configuration
// Escape the double slash in https URLs as https:/$()/... because .xcconfig
// treats // as a comment.
SUPABASE_URL = https:/$()/your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY = your-supabase-publishable-key-here
SUPABASE_ANON_KEY = your-supabase-anon-key-here

// Optional: Environment-specific configurations
// For production, consider creating separate files:
// - Config-Debug.xcconfig (for development)
// - Config-Release.xcconfig (for production/TestFlight)
